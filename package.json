{
  "name": "vectspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "editor",
    "packages/*"
  ],
  "scripts": {
    "assets:check": "node scripts/check-lfs-assets.mjs game/assets",
    "predev": "npm run assets:check",
    "dev": "vite --configLoader runner",
    "prebuild": "npm run assets:check",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "parity:check": "node scripts/check-scene-parity.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "editor:dev": "npm --prefix editor run tauri dev",
    "editor:build": "npm --prefix editor run tauri build",
    "editor:check": "npm --prefix editor run build",
    "codegen": "cargo run -p vectspace-core --bin export_schemas && cargo test -p vectspace-protocol export_bindings",
    "codegen:check": "node scripts/check-codegen.mjs",
    "check:all": "npm test && npm run build && npm --prefix editor test && npm --prefix editor run build && cargo test --workspace && cargo clippy --workspace --all-targets -- -D warnings"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@vectspace/presentation-core": "0.1.0",
    "@vectspace/presentation-react": "0.1.0",
    "@vectspace/text": "0.1.0",
    "@vectspace/text-react": "0.1.0",
    "katex": "0.18.4",
    "pixi.js": "8.20.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/katex": "0.16.8",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.9.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
