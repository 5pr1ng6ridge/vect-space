{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContentManifest",
  "type": "object",
  "properties": {
    "assets": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/AssetDefinition"
      }
    },
    "chapter_map": {
      "description": "Optional author-authored room map used as the chapter selector.  The\nlegacy story flow remains available for projects that have not yet\nmoved to a map.",
      "type": [
        "string",
        "null"
      ]
    },
    "characters": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/CharacterDefinition"
      },
      "default": {}
    },
    "content_version": {
      "type": "string"
    },
    "default_font": {
      "description": "Optional shared font asset used by game and editor previews.",
      "type": [
        "string",
        "null"
      ]
    },
    "default_locale": {
      "type": "string",
      "default": "zh-CN"
    },
    "entry_scene": {
      "type": "string"
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "story_flow": {
      "type": [
        "string",
        "null"
      ]
    },
    "ui_motion_defaults": {
      "$ref": "#/$defs/UiMotionBindings",
      "default": {}
    },
    "ui_motions": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "variables": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/VariableDefinition"
      },
      "default": {}
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_version",
    "entry_scene",
    "assets",
    "scenes"
  ],
  "$defs": {
    "AssetDefinition": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/AssetKind"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "path"
      ]
    },
    "AssetKind": {
      "type": "string",
      "enum": [
        "background",
        "sprite",
        "gui",
        "bgm",
        "sfx",
        "font",
        "video"
      ]
    },
    "CharacterDefinition": {
      "type": "object",
      "properties": {
        "display_name": {
          "type": "string"
        },
        "name_color": {
          "type": [
            "string",
            "null"
          ]
        },
        "text_color": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "display_name"
      ]
    },
    "ScalarValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "format": "int64"
        },
        {
          "type": "number",
          "format": "double"
        },
        {
          "type": "string"
        }
      ]
    },
    "UiMotionBindings": {
      "type": "object",
      "properties": {
        "dialogue_hide": {
          "type": [
            "string",
            "null"
          ]
        },
        "dialogue_show": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "VariableDefinition": {
      "type": "object",
      "properties": {
        "default": {
          "$ref": "#/$defs/ScalarValue"
        },
        "scope": {
          "$ref": "#/$defs/VariableScope"
        },
        "type": {
          "$ref": "#/$defs/VariableType"
        }
      },
      "additionalProperties": false,
      "required": [
        "scope",
        "type",
        "default"
      ]
    },
    "VariableScope": {
      "type": "string",
      "enum": [
        "save",
        "profile"
      ]
    },
    "VariableType": {
      "type": "string",
      "enum": [
        "boolean",
        "integer",
        "number",
        "string"
      ]
    }
  }
}