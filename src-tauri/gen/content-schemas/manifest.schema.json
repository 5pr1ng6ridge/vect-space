{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContentManifest",
  "type": "object",
  "properties": {
    "actions": {
      "description": "Optional reusable single-sprite action documents.  Empty preserves\nexisting projects and keeps the action system opt-in.",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "animations": {
      "description": "Optional standalone image animation documents.  Empty keeps legacy\nprojects fully compatible.",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/AssetDefinition"
      }
    },
    "buttons": {
      "description": "Optional reusable button template documents.  Empty keeps legacy\nprojects fully compatible.",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "chapter_map": {
      "description": "Optional author-authored room map used as the chapter selector.",
      "type": [
        "string",
        "null"
      ]
    },
    "characters": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/CharacterDefinition"
      },
      "default": {}
    },
    "content_version": {
      "type": "string"
    },
    "default_font": {
      "description": "Optional shared font asset used by game and editor previews.",
      "type": [
        "string",
        "null"
      ]
    },
    "default_locale": {
      "type": "string",
      "default": "zh-CN"
    },
    "entry_scene": {
      "type": "string"
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "ui_motion_defaults": {
      "$ref": "#/$defs/UiMotionBindings",
      "default": {}
    },
    "ui_motions": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "variables": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/VariableDefinition"
      },
      "default": {}
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_version",
    "entry_scene",
    "assets",
    "scenes"
  ],
  "$defs": {
    "AssetDefinition": {
      "type": "object",
      "properties": {
        "animation": {
          "description": "Loop animation document id.  The asset keeps its `kind`, so every\nexisting image position accepts an animated asset without a new field.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/AssetKind"
        },
        "path": {
          "description": "Static image path.  Mutually exclusive with `animation`; exactly one of\nthe two describes the pixels this logical asset resolves to.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    "AssetKind": {
      "type": "string",
      "enum": [
        "background",
        "sprite",
        "gui",
        "bgm",
        "ambience",
        "sfx",
        "font",
        "video"
      ]
    },
    "CharacterDefinition": {
      "type": "object",
      "properties": {
        "default_expression": {
          "type": [
            "string",
            "null"
          ]
        },
        "default_scale": {
          "type": "number",
          "format": "float",
          "default": 1.0
        },
        "display_name": {
          "type": "string"
        },
        "expressions": {
          "description": "Optional semantic portrait variants. A missing table preserves the\nlegacy generic-sprite authoring path.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/CharacterExpression"
          },
          "default": {}
        },
        "name_color": {
          "type": [
            "string",
            "null"
          ]
        },
        "text_color": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "display_name"
      ]
    },
    "CharacterExpression": {
      "type": "object",
      "properties": {
        "anchor_x": {
          "type": "number",
          "format": "float",
          "default": 0.5
        },
        "anchor_y": {
          "type": "number",
          "format": "float",
          "default": 1.0
        },
        "asset": {
          "type": "string"
        },
        "offset_x": {
          "type": "number",
          "format": "float",
          "default": 0.0
        },
        "offset_y": {
          "type": "number",
          "format": "float",
          "default": 0.0
        },
        "scale": {
          "type": "number",
          "format": "float",
          "default": 1.0
        }
      },
      "additionalProperties": false,
      "required": [
        "asset"
      ]
    },
    "ScalarValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "format": "int64"
        },
        {
          "type": "number",
          "format": "double"
        },
        {
          "type": "string"
        }
      ]
    },
    "UiMotionBindings": {
      "type": "object",
      "properties": {
        "dialogue_hide": {
          "type": [
            "string",
            "null"
          ]
        },
        "dialogue_show": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "VariableDefinition": {
      "type": "object",
      "properties": {
        "default": {
          "$ref": "#/$defs/ScalarValue"
        },
        "scope": {
          "$ref": "#/$defs/VariableScope"
        },
        "type": {
          "$ref": "#/$defs/VariableType"
        }
      },
      "additionalProperties": false,
      "required": [
        "scope",
        "type",
        "default"
      ]
    },
    "VariableScope": {
      "type": "string",
      "enum": [
        "save",
        "profile"
      ]
    },
    "VariableType": {
      "type": "string",
      "enum": [
        "boolean",
        "integer",
        "number",
        "string"
      ]
    }
  }
}