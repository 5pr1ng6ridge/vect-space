{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SceneDefinition",
  "type": "object",
  "properties": {
    "entry": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/SceneNode"
      }
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "entry",
    "nodes"
  ],
  "$defs": {
    "AudioAction": {
      "type": "string",
      "enum": [
        "start",
        "stop"
      ]
    },
    "BackgroundTransition": {
      "type": "string",
      "enum": [
        "cut",
        "cross_fade"
      ]
    },
    "ChoiceDefinition": {
      "type": "object",
      "properties": {
        "enabled_if": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConditionExpression"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "next": {
          "type": "string"
        },
        "visible_if": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConditionExpression"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "next"
      ]
    },
    "ConditionExpression": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "left": {
              "$ref": "#/$defs/ValueOperand"
            },
            "op": {
              "type": "string",
              "const": "eq"
            },
            "right": {
              "$ref": "#/$defs/ValueOperand"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "properties": {
            "left": {
              "$ref": "#/$defs/ValueOperand"
            },
            "op": {
              "type": "string",
              "const": "ne"
            },
            "right": {
              "$ref": "#/$defs/ValueOperand"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "properties": {
            "left": {
              "$ref": "#/$defs/ValueOperand"
            },
            "op": {
              "type": "string",
              "const": "lt"
            },
            "right": {
              "$ref": "#/$defs/ValueOperand"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "properties": {
            "left": {
              "$ref": "#/$defs/ValueOperand"
            },
            "op": {
              "type": "string",
              "const": "le"
            },
            "right": {
              "$ref": "#/$defs/ValueOperand"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "properties": {
            "left": {
              "$ref": "#/$defs/ValueOperand"
            },
            "op": {
              "type": "string",
              "const": "gt"
            },
            "right": {
              "$ref": "#/$defs/ValueOperand"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "properties": {
            "left": {
              "$ref": "#/$defs/ValueOperand"
            },
            "op": {
              "type": "string",
              "const": "ge"
            },
            "right": {
              "$ref": "#/$defs/ValueOperand"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "properties": {
            "conditions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ConditionExpression"
              }
            },
            "op": {
              "type": "string",
              "const": "and"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "conditions"
          ]
        },
        {
          "type": "object",
          "properties": {
            "conditions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ConditionExpression"
              }
            },
            "op": {
              "type": "string",
              "const": "or"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "conditions"
          ]
        },
        {
          "type": "object",
          "properties": {
            "condition": {
              "$ref": "#/$defs/ConditionExpression"
            },
            "op": {
              "type": "string",
              "const": "not"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "condition"
          ]
        }
      ]
    },
    "CtrlFastForwardMode": {
      "type": "string",
      "enum": [
        "allow",
        "block"
      ]
    },
    "Easing": {
      "type": "string",
      "enum": [
        "linear",
        "ease_in",
        "ease_out",
        "ease_in_out"
      ]
    },
    "LiteralOperand": {
      "type": "object",
      "properties": {
        "value": {
          "$ref": "#/$defs/ScalarValue"
        }
      },
      "additionalProperties": false,
      "required": [
        "value"
      ]
    },
    "MutationValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/VariableOperand"
        },
        {
          "$ref": "#/$defs/ScalarValue"
        }
      ]
    },
    "PlaybackAutoMode": {
      "type": "string",
      "enum": [
        "normal",
        "forced"
      ]
    },
    "ScalarValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "format": "int64"
        },
        {
          "type": "number",
          "format": "double"
        },
        {
          "type": "string"
        }
      ]
    },
    "SceneNode": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "await": {
              "type": "boolean",
              "default": false
            },
            "background": {
              "type": [
                "string",
                "null"
              ]
            },
            "duration_ms": {
              "type": "integer",
              "format": "uint64",
              "default": 500,
              "minimum": 0
            },
            "easing": {
              "$ref": "#/$defs/Easing",
              "default": "ease_in_out"
            },
            "next": {
              "type": "string"
            },
            "transition": {
              "$ref": "#/$defs/BackgroundTransition",
              "default": "cross_fade"
            },
            "type": {
              "type": "string",
              "const": "background"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "next"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "$ref": "#/$defs/SpriteAction"
            },
            "asset": {
              "type": [
                "string",
                "null"
              ]
            },
            "await": {
              "type": "boolean",
              "default": false
            },
            "duration_ms": {
              "type": "integer",
              "format": "uint64",
              "default": 500,
              "minimum": 0
            },
            "easing": {
              "$ref": "#/$defs/Easing",
              "default": "ease_in_out"
            },
            "next": {
              "type": "string"
            },
            "opacity": {
              "type": [
                "number",
                "null"
              ],
              "format": "float"
            },
            "scale": {
              "type": [
                "number",
                "null"
              ],
              "format": "float"
            },
            "sprite_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "sprite"
            },
            "x": {
              "type": [
                "number",
                "null"
              ],
              "format": "float"
            },
            "y": {
              "type": [
                "number",
                "null"
              ],
              "format": "float"
            },
            "z": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int32"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "sprite_id",
            "action",
            "next"
          ]
        },
        {
          "type": "object",
          "properties": {
            "next": {
              "type": "string"
            },
            "speaker": {
              "type": [
                "string",
                "null"
              ]
            },
            "speed_cps": {
              "type": [
                "number",
                "null"
              ],
              "format": "float",
              "default": null
            },
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "say"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "text",
            "next"
          ]
        },
        {
          "type": "object",
          "properties": {
            "choices": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ChoiceDefinition"
              }
            },
            "type": {
              "type": "string",
              "const": "choice"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "choices"
          ]
        },
        {
          "type": "object",
          "properties": {
            "next": {
              "type": "string"
            },
            "op": {
              "$ref": "#/$defs/VariableOperation",
              "default": "assign"
            },
            "type": {
              "type": "string",
              "const": "set"
            },
            "value": {
              "anyOf": [
                {
                  "$ref": "#/$defs/MutationValue"
                },
                {
                  "type": "null"
                }
              ]
            },
            "variable": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "variable",
            "next"
          ]
        },
        {
          "type": "object",
          "properties": {
            "condition": {
              "$ref": "#/$defs/ConditionExpression"
            },
            "otherwise": {
              "type": "string"
            },
            "then": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "condition"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "condition",
            "then",
            "otherwise"
          ]
        },
        {
          "type": "object",
          "properties": {
            "auto": {
              "$ref": "#/$defs/PlaybackAutoMode"
            },
            "ctrl_fast_forward": {
              "$ref": "#/$defs/CtrlFastForwardMode"
            },
            "next": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "playback"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "auto",
            "ctrl_fast_forward",
            "next"
          ]
        },
        {
          "type": "object",
          "properties": {
            "scene": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "target": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "jump"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "target"
          ]
        },
        {
          "type": "object",
          "properties": {
            "duration_ms": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "next": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "wait"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "duration_ms",
            "next"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "$ref": "#/$defs/AudioAction"
            },
            "asset": {
              "type": [
                "string",
                "null"
              ]
            },
            "await": {
              "type": "boolean",
              "default": false
            },
            "duration_ms": {
              "type": "integer",
              "format": "uint64",
              "default": 500,
              "minimum": 0
            },
            "next": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "bgm"
            },
            "volume": {
              "type": "number",
              "format": "float",
              "default": 1.0
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "action",
            "next"
          ]
        },
        {
          "type": "object",
          "properties": {
            "asset": {
              "type": "string"
            },
            "next": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "sfx"
            },
            "volume": {
              "type": "number",
              "format": "float",
              "default": 1.0
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "asset",
            "next"
          ]
        },
        {
          "type": "object",
          "properties": {
            "await": {
              "type": "boolean",
              "default": false
            },
            "duration_ms": {
              "type": "integer",
              "format": "uint64",
              "default": 500,
              "minimum": 0
            },
            "easing": {
              "$ref": "#/$defs/Easing",
              "default": "ease_in_out"
            },
            "next": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "camera"
            },
            "x": {
              "type": "number",
              "format": "float"
            },
            "y": {
              "type": "number",
              "format": "float"
            },
            "zoom": {
              "type": "number",
              "format": "float"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "x",
            "y",
            "zoom",
            "next"
          ]
        },
        {
          "type": "object",
          "properties": {
            "await": {
              "type": "boolean",
              "default": false
            },
            "duration_ms": {
              "type": "integer",
              "format": "uint64",
              "default": 200,
              "minimum": 0
            },
            "effect": {
              "$ref": "#/$defs/ScreenEffectKind"
            },
            "next": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "screen_effect"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "effect",
            "next"
          ]
        },
        {
          "type": "object",
          "properties": {
            "await": {
              "type": "boolean",
              "default": false
            },
            "duration_ms": {
              "type": "integer",
              "format": "uint64",
              "default": 200,
              "minimum": 0
            },
            "next": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "dialogue_ui"
            },
            "visible": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "visible",
            "next"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "end"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        }
      ]
    },
    "ScreenEffectKind": {
      "type": "string",
      "enum": [
        "shake",
        "flash"
      ]
    },
    "SpriteAction": {
      "type": "string",
      "enum": [
        "show",
        "move",
        "hide"
      ]
    },
    "ValueOperand": {
      "anyOf": [
        {
          "$ref": "#/$defs/VariableOperand"
        },
        {
          "$ref": "#/$defs/LiteralOperand"
        }
      ]
    },
    "VariableOperand": {
      "type": "object",
      "properties": {
        "variable": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "variable"
      ]
    },
    "VariableOperation": {
      "type": "string",
      "enum": [
        "assign",
        "add",
        "sub",
        "mul",
        "mod",
        "append",
        "toggle"
      ]
    }
  }
}