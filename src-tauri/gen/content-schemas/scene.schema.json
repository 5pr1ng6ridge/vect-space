{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SceneDefinition",
  "type": "object",
  "properties": {
    "entry": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/SceneNode"
      }
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "entry",
    "nodes"
  ],
  "$defs": {
    "AudioAction": {
      "type": "string",
      "enum": [
        "start",
        "stop"
      ]
    },
    "BackgroundTransition": {
      "type": "string",
      "enum": [
        "cut",
        "cross_fade"
      ]
    },
    "ChoiceDefinition": {
      "type": "object",
      "properties": {
        "enabled_if": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConditionExpression"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "next": {
          "type": "string"
        },
        "visible_if": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConditionExpression"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "next"
      ]
    },
    "ConditionExpression": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "left": {
              "$ref": "#/$defs/ValueOperand"
            },
            "op": {
              "type": "string",
              "const": "eq"
            },
            "right": {
              "$ref": "#/$defs/ValueOperand"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "properties": {
            "left": {
              "$ref": "#/$defs/ValueOperand"
            },
            "op": {
              "type": "string",
              "const": "ne"
            },
            "right": {
              "$ref": "#/$defs/ValueOperand"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "properties": {
            "left": {
              "$ref": "#/$defs/ValueOperand"
            },
            "op": {
              "type": "string",
              "const": "lt"
            },
            "right": {
              "$ref": "#/$defs/ValueOperand"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "properties": {
            "left": {
              "$ref": "#/$defs/ValueOperand"
            },
            "op": {
              "type": "string",
              "const": "le"
            },
            "right": {
              "$ref": "#/$defs/ValueOperand"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "properties": {
            "left": {
              "$ref": "#/$defs/ValueOperand"
            },
            "op": {
              "type": "string",
              "const": "gt"
            },
            "right": {
              "$ref": "#/$defs/ValueOperand"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "properties": {
            "left": {
              "$ref": "#/$defs/ValueOperand"
            },
            "op": {
              "type": "string",
              "const": "ge"
            },
            "right": {
              "$ref": "#/$defs/ValueOperand"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "properties": {
            "conditions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ConditionExpression"
              }
            },
            "op": {
              "type": "string",
              "const": "and"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "conditions"
          ]
        },
        {
          "type": "object",
          "properties": {
            "conditions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ConditionExpression"
              }
            },
            "op": {
              "type": "string",
              "const": "or"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "conditions"
          ]
        },
        {
          "type": "object",
          "properties": {
            "condition": {
              "$ref": "#/$defs/ConditionExpression"
            },
            "op": {
              "type": "string",
              "const": "not"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "condition"
          ]
        }
      ]
    },
    "CtrlFastForwardMode": {
      "type": "string",
      "enum": [
        "allow",
        "block"
      ]
    },
    "DialogueMode": {
      "type": "string",
      "enum": [
        "start",
        "append"
      ]
    },
    "Easing": {
      "type": "string",
      "enum": [
        "linear",
        "ease_in",
        "ease_out",
        "ease_in_out"
      ]
    },
    "LiteralOperand": {
      "type": "object",
      "properties": {
        "value": {
          "$ref": "#/$defs/ScalarValue"
        }
      },
      "additionalProperties": false,
      "required": [
        "value"
      ]
    },
    "LongTextLayout": {
      "type": "object",
      "properties": {
        "height": {
          "type": "number",
          "format": "float",
          "default": 1080.0
        },
        "padding_x": {
          "type": "number",
          "format": "float",
          "default": 118.0
        },
        "padding_y": {
          "type": "number",
          "format": "float",
          "default": 112.0
        },
        "page_gap": {
          "type": "number",
          "format": "float",
          "default": 92.0
        },
        "page_height": {
          "type": "number",
          "format": "float",
          "default": 1340.0
        },
        "width": {
          "type": "number",
          "format": "float",
          "default": 1240.0
        },
        "x": {
          "type": "number",
          "format": "float",
          "default": 340.0
        },
        "y": {
          "type": "number",
          "format": "float",
          "default": 0.0
        }
      },
      "additionalProperties": false
    },
    "LongTextPagination": {
      "type": "string",
      "enum": [
        "continuous",
        "auto",
        "manual"
      ]
    },
    "LongTextStep": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "page_break_before": {
          "type": "boolean",
          "default": false
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ]
    },
    "MutationValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/VariableOperand"
        },
        {
          "$ref": "#/$defs/ScalarValue"
        }
      ]
    },
    "PlaybackAutoMode": {
      "type": "string",
      "enum": [
        "normal",
        "forced"
      ]
    },
    "ScalarValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "format": "int64"
        },
        {
          "type": "number",
          "format": "double"
        },
        {
          "type": "string"
        }
      ]
    },
    "SceneNode": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "await": {
              "type": "boolean",
              "default": false
            },
            "background": {
              "type": [
                "string",
                "null"
              ]
            },
            "duration_ms": {
              "type": "integer",
              "format": "uint64",
              "default": 500,
              "minimum": 0
            },
            "easing": {
              "$ref": "#/$defs/Easing",
              "default": "ease_in_out"
            },
            "next": {
              "type": "string"
            },
            "transition": {
              "$ref": "#/$defs/BackgroundTransition",
              "default": "cross_fade"
            },
            "type": {
              "type": "string",
              "const": "background"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "next"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "$ref": "#/$defs/SpriteAction"
            },
            "asset": {
              "type": [
                "string",
                "null"
              ]
            },
            "await": {
              "type": "boolean",
              "default": false
            },
            "duration_ms": {
              "type": "integer",
              "format": "uint64",
              "default": 500,
              "minimum": 0
            },
            "easing": {
              "$ref": "#/$defs/Easing",
              "default": "ease_in_out"
            },
            "next": {
              "type": "string"
            },
            "opacity": {
              "type": [
                "number",
                "null"
              ],
              "format": "float"
            },
            "scale": {
              "type": [
                "number",
                "null"
              ],
              "format": "float"
            },
            "sprite_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "sprite"
            },
            "x": {
              "type": [
                "number",
                "null"
              ],
              "format": "float"
            },
            "y": {
              "type": [
                "number",
                "null"
              ],
              "format": "float"
            },
            "z": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int32"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "sprite_id",
            "action",
            "next"
          ]
        },
        {
          "description": "Fade the current scene's visual world to an empty state. Audio and the\ndialogue UI are deliberately left alone so a scene transition can keep\nits BGM and common UI chrome.",
          "type": "object",
          "properties": {
            "await": {
              "type": "boolean",
              "default": true
            },
            "duration_ms": {
              "type": "integer",
              "format": "uint64",
              "default": 500,
              "minimum": 0
            },
            "easing": {
              "$ref": "#/$defs/Easing",
              "default": "ease_in_out"
            },
            "next": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "clear"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "next"
          ]
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "$ref": "#/$defs/DialogueMode",
              "default": "start"
            },
            "next": {
              "type": "string"
            },
            "page_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "reveal_animation": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TextRevealAnimation"
                },
                {
                  "type": "null"
                }
              ]
            },
            "speaker": {
              "type": [
                "string",
                "null"
              ]
            },
            "speed_cps": {
              "type": [
                "number",
                "null"
              ],
              "format": "float",
              "default": null
            },
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "say"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "text",
            "next"
          ]
        },
        {
          "description": "A sequence of explanatory text blocks rendered on a vertically flowing\npaper surface. Unlike `say`, the runtime stays on this node until its\nfinal step has been advanced, so every step is revision-safe and can be\nsaved independently.",
          "type": "object",
          "properties": {
            "font_size": {
              "type": "number",
              "format": "float"
            },
            "layout": {
              "$ref": "#/$defs/LongTextLayout"
            },
            "next": {
              "type": "string"
            },
            "pagination": {
              "$ref": "#/$defs/LongTextPagination"
            },
            "paper": {
              "type": [
                "string",
                "null"
              ]
            },
            "reveal_animation": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TextRevealAnimation"
                },
                {
                  "type": "null"
                }
              ]
            },
            "speed_cps": {
              "type": [
                "number",
                "null"
              ],
              "format": "float",
              "default": null
            },
            "steps": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/LongTextStep"
              }
            },
            "text_color": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "long_text"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "steps",
            "next"
          ]
        },
        {
          "type": "object",
          "properties": {
            "choices": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ChoiceDefinition"
              }
            },
            "type": {
              "type": "string",
              "const": "choice"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "choices"
          ]
        },
        {
          "type": "object",
          "properties": {
            "next": {
              "type": "string"
            },
            "op": {
              "$ref": "#/$defs/VariableOperation",
              "default": "assign"
            },
            "type": {
              "type": "string",
              "const": "set"
            },
            "value": {
              "anyOf": [
                {
                  "$ref": "#/$defs/MutationValue"
                },
                {
                  "type": "null"
                }
              ]
            },
            "variable": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "variable",
            "next"
          ]
        },
        {
          "type": "object",
          "properties": {
            "condition": {
              "$ref": "#/$defs/ConditionExpression"
            },
            "otherwise": {
              "type": "string"
            },
            "then": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "condition"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "condition",
            "then",
            "otherwise"
          ]
        },
        {
          "type": "object",
          "properties": {
            "auto": {
              "$ref": "#/$defs/PlaybackAutoMode"
            },
            "ctrl_fast_forward": {
              "$ref": "#/$defs/CtrlFastForwardMode"
            },
            "next": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "playback"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "auto",
            "ctrl_fast_forward",
            "next"
          ]
        },
        {
          "type": "object",
          "properties": {
            "scene": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "target": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "jump"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "target"
          ]
        },
        {
          "type": "object",
          "properties": {
            "duration_ms": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "next": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "wait"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "duration_ms",
            "next"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "$ref": "#/$defs/AudioAction"
            },
            "asset": {
              "type": [
                "string",
                "null"
              ]
            },
            "await": {
              "type": "boolean",
              "default": false
            },
            "duration_ms": {
              "type": "integer",
              "format": "uint64",
              "default": 500,
              "minimum": 0
            },
            "loop_end_ms": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "loop_start_ms": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "next": {
              "type": "string"
            },
            "start_ms": {
              "type": "integer",
              "format": "uint64",
              "default": 0,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "bgm"
            },
            "volume": {
              "type": "number",
              "format": "float",
              "default": 1.0
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "action",
            "next"
          ]
        },
        {
          "type": "object",
          "properties": {
            "await": {
              "type": "boolean"
            },
            "duration_ms": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "events": {
              "type": "array",
              "default": [],
              "items": {
                "$ref": "#/$defs/TimelineEvent"
              }
            },
            "next": {
              "type": "string"
            },
            "skippable": {
              "type": "boolean"
            },
            "tracks": {
              "type": "array",
              "default": [],
              "items": {
                "$ref": "#/$defs/TimelineTrack"
              }
            },
            "type": {
              "type": "string",
              "const": "timeline"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "duration_ms",
            "await",
            "skippable",
            "next"
          ]
        },
        {
          "type": "object",
          "properties": {
            "asset": {
              "type": "string"
            },
            "next": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "sfx"
            },
            "volume": {
              "type": "number",
              "format": "float",
              "default": 1.0
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "asset",
            "next"
          ]
        },
        {
          "type": "object",
          "properties": {
            "await": {
              "type": "boolean",
              "default": false
            },
            "duration_ms": {
              "type": "integer",
              "format": "uint64",
              "default": 500,
              "minimum": 0
            },
            "easing": {
              "$ref": "#/$defs/Easing",
              "default": "ease_in_out"
            },
            "next": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "camera"
            },
            "x": {
              "type": "number",
              "format": "float"
            },
            "y": {
              "type": "number",
              "format": "float"
            },
            "zoom": {
              "type": "number",
              "format": "float"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "x",
            "y",
            "zoom",
            "next"
          ]
        },
        {
          "type": "object",
          "properties": {
            "await": {
              "type": "boolean",
              "default": false
            },
            "duration_ms": {
              "type": "integer",
              "format": "uint64",
              "default": 200,
              "minimum": 0
            },
            "effect": {
              "$ref": "#/$defs/ScreenEffectKind"
            },
            "next": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "screen_effect"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "effect",
            "next"
          ]
        },
        {
          "type": "object",
          "properties": {
            "await": {
              "type": "boolean",
              "default": false
            },
            "duration_ms": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "default": null,
              "minimum": 0
            },
            "motion": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "next": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "dialogue_ui"
            },
            "visible": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "visible",
            "next"
          ]
        },
        {
          "type": "object",
          "properties": {
            "motion": {
              "type": [
                "string",
                "null"
              ]
            },
            "next": {
              "type": "string"
            },
            "slot": {
              "$ref": "#/$defs/UiMotionSlot"
            },
            "type": {
              "type": "string",
              "const": "ui_motion_set"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "slot",
            "next"
          ]
        },
        {
          "type": "object",
          "properties": {
            "await": {
              "type": "boolean",
              "default": false
            },
            "duration_ms": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "default": null,
              "minimum": 0
            },
            "motion": {
              "type": "string"
            },
            "next": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "ui_motion_play"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "motion",
            "next"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "end"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        }
      ]
    },
    "ScreenEffectKind": {
