{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StoryFlowDefinition",
  "type": "object",
  "properties": {
    "edges": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/StoryFlowEdge"
      }
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/StoryFlowNode"
      },
      "default": {}
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version"
  ],
  "$defs": {
    "ConditionExpression": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "left": {
              "$ref": "#/$defs/ValueOperand"
            },
            "op": {
              "type": "string",
              "const": "eq"
            },
            "right": {
              "$ref": "#/$defs/ValueOperand"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "properties": {
            "left": {
              "$ref": "#/$defs/ValueOperand"
            },
            "op": {
              "type": "string",
              "const": "ne"
            },
            "right": {
              "$ref": "#/$defs/ValueOperand"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "properties": {
            "left": {
              "$ref": "#/$defs/ValueOperand"
            },
            "op": {
              "type": "string",
              "const": "lt"
            },
            "right": {
              "$ref": "#/$defs/ValueOperand"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "properties": {
            "left": {
              "$ref": "#/$defs/ValueOperand"
            },
            "op": {
              "type": "string",
              "const": "le"
            },
            "right": {
              "$ref": "#/$defs/ValueOperand"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "properties": {
            "left": {
              "$ref": "#/$defs/ValueOperand"
            },
            "op": {
              "type": "string",
              "const": "gt"
            },
            "right": {
              "$ref": "#/$defs/ValueOperand"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "properties": {
            "left": {
              "$ref": "#/$defs/ValueOperand"
            },
            "op": {
              "type": "string",
              "const": "ge"
            },
            "right": {
              "$ref": "#/$defs/ValueOperand"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "properties": {
            "conditions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ConditionExpression"
              }
            },
            "op": {
              "type": "string",
              "const": "and"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "conditions"
          ]
        },
        {
          "type": "object",
          "properties": {
            "conditions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ConditionExpression"
              }
            },
            "op": {
              "type": "string",
              "const": "or"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "conditions"
          ]
        },
        {
          "type": "object",
          "properties": {
            "condition": {
              "$ref": "#/$defs/ConditionExpression"
            },
            "op": {
              "type": "string",
              "const": "not"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "condition"
          ]
        }
      ]
    },
    "LiteralOperand": {
      "type": "object",
      "properties": {
        "value": {
          "$ref": "#/$defs/ScalarValue"
        }
      },
      "additionalProperties": false,
      "required": [
        "value"
      ]
    },
    "ScalarValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "format": "int64"
        },
        {
          "type": "number",
          "format": "double"
        },
        {
          "type": "string"
        }
      ]
    },
    "StoryFlowEdge": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "to": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to"
      ]
    },
    "StoryFlowNode": {
      "type": "object",
      "properties": {
        "reveal": {
          "$ref": "#/$defs/StoryFlowReveal",
          "default": {
            "mode": "completed"
          }
        },
        "title": {
          "type": "string"
        },
        "x": {
          "type": "integer",
          "format": "int32"
        },
        "y": {
          "type": "integer",
          "format": "int32"
        }
      },
      "additionalProperties": false,
      "required": [
        "title",
        "x",
        "y"
      ]
    },
    "StoryFlowReveal": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "completed"
            }
          },
          "additionalProperties": false,
          "required": [
            "mode"
          ]
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "always"
            }
          },
          "additionalProperties": false,
          "required": [
            "mode"
          ]
        },
        {
          "type": "object",
          "properties": {
            "condition": {
              "$ref": "#/$defs/ConditionExpression"
            },
            "mode": {
              "type": "string",
              "const": "condition"
            }
          },
          "additionalProperties": false,
          "required": [
            "mode",
            "condition"
          ]
        }
      ]
    },
    "ValueOperand": {
      "anyOf": [
        {
          "$ref": "#/$defs/VariableOperand"
        },
        {
          "$ref": "#/$defs/LiteralOperand"
        }
      ]
    },
    "VariableOperand": {
      "type": "object",
      "properties": {
        "variable": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "variable"
      ]
    }
  }
}