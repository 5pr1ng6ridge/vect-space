{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChapterMapDefinition",
  "description": "A room-sized chapter selector.  Coordinates are design pixels and are\ndeliberately kept independent from the story graph so authors can compose\na spatial map without changing story control flow.",
  "type": "object",
  "properties": {
    "background": {
      "type": [
        "string",
        "null"
      ]
    },
    "decorations": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/ChapterMapDecoration"
      }
    },
    "height": {
      "type": "integer",
      "format": "uint32",
      "default": 1080,
      "minimum": 0
    },
    "hotspots": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/ChapterMapHotspot"
      }
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "view_x": {
      "type": "integer",
      "format": "int32",
      "default": 960
    },
    "view_y": {
      "type": "integer",
      "format": "int32",
      "default": 540
    },
    "width": {
      "type": "integer",
      "format": "uint32",
      "default": 1920,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version"
  ],
  "$defs": {
    "ChapterMapDecoration": {
      "type": "object",
      "properties": {
        "asset": {
          "type": "string"
        },
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "id": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "x": {
          "type": "integer",
          "format": "int32"
        },
        "y": {
          "type": "integer",
          "format": "int32"
        },
        "z": {
          "type": "integer",
          "format": "int32",
          "default": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "asset",
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "ChapterMapHotspot": {
      "type": "object",
      "properties": {
        "asset": {
          "type": [
            "string",
            "null"
          ]
        },
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "hover_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "replay": {
          "description": "Replay policy for this chapter.  Kept separate from `reveal` on\npurpose: visibility and enterability are different questions, so a\nhotspot may be shown but locked (default) or shown and enterable.",
          "$ref": "#/$defs/ChapterMapReplay",
          "default": {
            "mode": "completed"
          }
        },
        "reveal": {
          "$ref": "#/$defs/ChapterMapReveal",
          "default": {
            "mode": "completed"
          }
        },
        "scene_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "variable_overrides": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ScalarValue"
          },
          "default": {}
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "x": {
          "type": "integer",
          "format": "int32"
        },
        "y": {
          "type": "integer",
          "format": "int32"
        },
        "z": {
          "type": "integer",
          "format": "int32",
          "default": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "scene_id",
        "title",
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "ChapterMapReplay": {
      "description": "When the chapter may be entered from the room map.\n\n`completed` is the historical behaviour: a chapter becomes replayable only\nafter the player finished it once.  `always` opens the hotspot before the\nstory ever reaches it, which is what makes an unreached chapter (a\nshowcase, an appendix, a debugging scene) enterable on purpose.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "completed"
            }
          },
          "additionalProperties": false,
          "required": [
            "mode"
          ]
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "always"
            }
          },
          "additionalProperties": false,
          "required": [
            "mode"
          ]
        }
      ]
    },
    "ChapterMapReveal": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "completed"
            }
          },
          "additionalProperties": false,
          "required": [
            "mode"
          ]
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "always"
            }
          },
          "additionalProperties": false,
          "required": [
            "mode"
          ]
        },
        {
          "type": "object",
          "properties": {
            "condition": {
              "$ref": "#/$defs/ConditionExpression"
            },
            "mode": {
              "type": "string",
              "const": "condition"
            }
          },
          "additionalProperties": false,
          "required": [
            "mode",
            "condition"
          ]
        }
      ]
    },
    "ConditionExpression": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "left": {
              "$ref": "#/$defs/ValueOperand"
            },
            "op": {
              "type": "string",
              "const": "eq"
            },
            "right": {
              "$ref": "#/$defs/ValueOperand"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "properties": {
            "left": {
              "$ref": "#/$defs/ValueOperand"
            },
            "op": {
              "type": "string",
              "const": "ne"
            },
            "right": {
              "$ref": "#/$defs/ValueOperand"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "properties": {
            "left": {
              "$ref": "#/$defs/ValueOperand"
            },
            "op": {
              "type": "string",
              "const": "lt"
            },
            "right": {
              "$ref": "#/$defs/ValueOperand"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "properties": {
            "left": {
              "$ref": "#/$defs/ValueOperand"
            },
            "op": {
              "type": "string",
              "const": "le"
            },
            "right": {
              "$ref": "#/$defs/ValueOperand"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "properties": {
            "left": {
              "$ref": "#/$defs/ValueOperand"
            },
            "op": {
              "type": "string",
              "const": "gt"
            },
            "right": {
              "$ref": "#/$defs/ValueOperand"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "properties": {
            "left": {
              "$ref": "#/$defs/ValueOperand"
            },
            "op": {
              "type": "string",
              "const": "ge"
            },
            "right": {
              "$ref": "#/$defs/ValueOperand"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "properties": {
            "conditions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ConditionExpression"
              }
            },
            "op": {
              "type": "string",
              "const": "and"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "conditions"
          ]
        },
        {
          "type": "object",
          "properties": {
            "conditions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ConditionExpression"
              }
            },
            "op": {
              "type": "string",
              "const": "or"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "conditions"
          ]
        },
        {
          "type": "object",
          "properties": {
            "condition": {
              "$ref": "#/$defs/ConditionExpression"
            },
            "op": {
              "type": "string",
              "const": "not"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "condition"
          ]
        }
      ]
    },
    "LiteralOperand": {
      "type": "object",
      "properties": {
        "value": {
          "$ref": "#/$defs/ScalarValue"
        }
      },
      "additionalProperties": false,
      "required": [
        "value"
      ]
    },
    "ScalarValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "format": "int64"
        },
        {
          "type": "number",
          "format": "double"
        },
        {
          "type": "string"
        }
      ]
    },
    "ValueOperand": {
      "anyOf": [
        {
          "$ref": "#/$defs/VariableOperand"
        },
        {
          "$ref": "#/$defs/LiteralOperand"
        }
      ]
    },
    "VariableOperand": {
      "type": "object",
      "properties": {
        "variable": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "variable"
      ]
    }
  }
}