{
  "name": "vectspace-story-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "assets:check": "node ../scripts/check-lfs-assets.mjs ../game/assets",
    "predev": "npm run assets:check",
    "dev": "vite",
    "prebuild": "npm run assets:check",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build",
    "test": "vitest run",
    "lint": "npm --prefix .. run lint",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@vectspace/presentation-core": "0.1.0",
    "@xyflow/react": "12.11.3",
    "elkjs": "0.12.0",
    "immer": "10.1.3",
    "katex": "0.18.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/katex": "0.16.8",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
